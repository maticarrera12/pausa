---
import { articles } from '../data/content';
const main = articles.proporcion;
const side = [articles.uniones, articles.quedarse];
const thumb = (url: string, w: number) => url.replace(/w=\d+/, `w=${w}`);
---
<section id="diario" class="bg-tinta px-page py-[clamp(96px,13vw,190px)] text-crema">
  <div data-reveal class="mb-[clamp(48px,6vw,88px)] flex flex-wrap items-baseline justify-between gap-4">
    <h2 class="m-0 font-display text-[clamp(28px,2.8vw,40px)] font-medium tracking-[-0.03em]">Diario</h2>
    <span class="eyebrow text-ocre">Notas desde el estudio</span>
  </div>
  <div class="flex flex-wrap items-start gap-x-[clamp(32px,6vw,96px)] gap-y-16">
    <button data-read={main.id} data-reveal class="flex flex-[3_1_440px] flex-col gap-5 text-left text-crema hover:opacity-90">
      <div class="aspect-[4/3] w-full overflow-hidden"><img loading="lazy" src={main.img} alt={main.alt} class="size-full object-cover transition-transform duration-500 ease-[cubic-bezier(.23,1,.32,1)] hover:scale-[1.02]" /></div>
      <span class="text-xs uppercase tracking-[0.1em] opacity-80">{main.meta}</span>
      <span class="max-w-140 font-display text-[clamp(26px,2.6vw,38px)] leading-[1.08] font-medium tracking-[-0.03em] text-balance">{main.title}</span>
      <span class="max-w-115 text-[15px] leading-[1.65] opacity-90">Sobre los dos centímetros que separan una silla en la que te sientas de una silla que recuerdas.</span>
      <span class="link-action text-ocre">Leer el ensayo →</span>
    </button>
    <div class="flex flex-[2_1_300px] flex-col gap-18 pt-[clamp(0px,10vw,160px)]">
      {side.map((a, i) => (
        <button data-read={a.id} data-reveal style={`--d:${i + 1}`} class="flex items-start gap-6 text-left text-crema hover:opacity-90">
          <div class="aspect-[3/4] shrink-0 basis-[clamp(96px,10vw,140px)] overflow-hidden"><img loading="lazy" src={thumb(a.img, 500)} alt={a.alt} class="size-full object-cover" /></div>
          <div class="flex flex-col gap-3">
            <span class="text-xs uppercase tracking-[0.1em] opacity-80">{a.meta}</span>
            <span class="font-display text-[22px] leading-[1.15] font-medium tracking-[-0.02em]">{a.title}</span>
          </div>
        </button>
      ))}
    </div>
  </div>
</section>
