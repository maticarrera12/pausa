---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Collection from '../components/Collection.astro';
import Objects from '../components/Objects.astro';
import Materials from '../components/Materials.astro';
import Interlude from '../components/Interlude.astro';
import Journal from '../components/Journal.astro';
import About from '../components/About.astro';
import Process from '../components/Process.astro';
import Visit from '../components/Visit.astro';
import Footer from '../components/Footer.astro';
import Panel from '../components/Panel.astro';
---
<Layout title="pausa — Objetos que dan forma a un espacio" description="Muebles y objetos contemporáneos diseñados en Milán para vivir contigo.">
  <Header />
  <main id="top">
    <Hero />
    <Collection />
    <Objects />
    <Materials />
    <Interlude />
    <Process />
    <Journal />
    <About />
    <Visit />
  </main>
  <Footer />
  <Panel />
  <script>
    import '../scripts/shop';
    import '../scripts/reveal';
  </script>
</Layout>
