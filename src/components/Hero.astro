<section class="box-border flex min-h-screen flex-wrap items-end justify-between gap-x-10 gap-y-14 bg-primario px-page pt-[clamp(120px,14vh,160px)] pb-[clamp(40px,6vh,64px)] text-tinta">
  <div class="order-3 flex max-w-140 flex-[1_1_300px] flex-col gap-7 sm:order-1">
    <span style="--i:0" class="enter eyebrow text-tinta">Colección Otoño 2026</span>
    <h1 style="--i:1" class="enter m-0 font-display text-[clamp(44px,6vw,88px)] leading-[0.98] font-medium tracking-[-0.045em] text-balance">Objetos que dan forma a un espacio.</h1>
    <p style="--i:2" class="enter m-0 max-w-80 text-[17px] leading-[1.55]">Objetos contemporáneos diseñados para vivir contigo.</p>
    <a href="#coleccion" style="--i:3" class="enter link-action self-start bg-[linear-gradient(#1F2A24,#1F2A24)] bg-[length:100%_1px] bg-bottom-left bg-no-repeat pb-1.5 transition-[background-size] duration-350 hover:bg-[length:30%_1px]">Explorar la colección →</a>
  </div>
  <figure style="--i:2" class="enter order-2 m-0 mr-[clamp(0px,4vw,96px)] flex flex-[0_1_clamp(260px,36vw,460px)] flex-col gap-3.5 self-start">
    <div class="aspect-[3/4] overflow-hidden bg-crema">
      <img src="/uploads/sillas.jpeg" alt="Tres sillas Arco en roble y nogal con respaldos curvos tapizados, una sobre un pedestal ocre, en una sala tranquila con una hornacina en arco" fetchpriority="high" class="size-full object-cover object-[50%_80%] transition-transform duration-500 ease-[cubic-bezier(.23,1,.32,1)] hover:scale-[1.025]" />
    </div>
    <figcaption class="flex justify-between gap-4 text-xs uppercase tracking-[0.06em]">
      <span>Silla Arco</span><span class="opacity-75">Roble o nogal, bouclé</span>
    </figcaption>
  </figure>
</section>
